# Razorpay Public Key for Frontend Checkout (Test Mode or Live Mode)
# Replace with your actual Razorpay Key ID from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id

# Backend API URL (leave empty to use Vite proxy /api configured in vite.config.js)
VITE_PAYMENT_API_URL=
